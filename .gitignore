# Secrets — production values stay local, never committed
.env
.env-stable
.env-stable.bak.*
.env.old

# Installer state — may contain answers we want re-prompted, never committed
.install-state.json

# User-customised prompt files. The shipped defaults (*.default.txt) are
# tracked; user overrides live in plain *.txt files alongside them and stay
# local.
prompts/*.txt
!prompts/*.default.txt

# Live operational data — never committed (privacy)
data/
media/
logs/
soupy_database/databases/
user_stats.json

# Python build / cache
__pycache__/
*.pyc
*.pyo

# Virtualenvs — never committed
.venv/
.venv-sd/

# OS / IDE
.DS_Store
.idea/
*.code-workspace

# Claude Code project state — local settings and dev-aid agents reference user paths
.claude/

# Working docs (delete these once cleanup commits land)
REVIEW_PLAN.md
REVIEW_BACKLOG.md
VISION_IMPLEMENTATION.md

# Stale legacy artifacts
soupy_flux.log
.schema
run_soupy.py

# Frontend (Vite scaffold) — node_modules and the dev-mode dist live local.
# The production bundle goes to web/static/dashboard/dist/ and IS tracked.
web/frontend/node_modules/
web/frontend/dist/
